{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "liberusoftware/boilerplate-laravel",
    "type": "project",
    "description": "Liberu boilerplate Laravel application.",
    "keywords": [
        "laravel",
        "framework",
        "boilerplate"
    ],
    "license": "MIT",
    "require": {
        "bezhansalleh/filament-shield": "^4.3.1",
        "bursteri/socialstream": "^7.0.0",
        "filament/filament": "^5.11.0",
        "filament/spatie-laravel-settings-plugin": "^5.11.0",
        "laravel/framework": "^13.38.0",
        "laravel/horizon": "^5.50.1",
        "laravel/jetstream": "^5.5.3",
        "laravel/octane": "^2.22.0",
        "laravel/pulse": "^1.8.1",
        "laravel/reverb": "^1.12.0",
        "laravel/sanctum": "^4.3.3",
        "laravel/socialite": "^5.31.0",
        "laravel/tinker": "^3.0.2",
        "liberusoftware/activity-comments": "^1.0",
        "liberusoftware/analytics-contracts": "^1.0",
        "liberusoftware/analytics-core": "^1.0",
        "liberusoftware/analytics-google": "^1.0",
        "liberusoftware/analytics-meta": "^1.0",
        "liberusoftware/api-access": "^1.0",
        "liberusoftware/application": "^1.0",
        "liberusoftware/audit": "^1.0",
        "liberusoftware/composer-installer": "^1.1",
        "liberusoftware/currency-context": "^1.0",
        "liberusoftware/developer-experience": "^1.0",
        "liberusoftware/feature-flags": "^1.0",
        "liberusoftware/files-media": "^1.0",
        "liberusoftware/identity-core": "^1.0",
        "liberusoftware/identity-core-filament": "^1.0",
        "liberusoftware/identity-socialstream": "^1.8.2",
        "liberusoftware/import-export": "^1.0",
        "liberusoftware/integrations": "^1.8.2",
        "liberusoftware/jetstream-bridge": "^1.0",
        "liberusoftware/localization-contracts": "^1.0",
        "liberusoftware/localization-core": "^1.5.1",
        "liberusoftware/localization-core-livewire": "^1.5.3",
        "liberusoftware/localization-mymemory": "^1.5.1",
        "liberusoftware/module-manager": "^1.9.2",
        "liberusoftware/module-manager-filament": "^1.11.2",
        "liberusoftware/notifications": "^1.0",
        "liberusoftware/observability": "^1.0",
        "liberusoftware/organizations-teams": "^1.10.3",
        "liberusoftware/organizations-teams-filament": "^1.0",
        "liberusoftware/profiles": "^1.0",
        "liberusoftware/roles-permissions": "^1.7.2",
        "liberusoftware/roles-permissions-filament": "^1.0",
        "liberusoftware/scheduler-queues": "^1.0",
        "liberusoftware/search": "^1.0",
        "liberusoftware/search-api": "^1.0",
        "liberusoftware/sessions-devices": "^1.5.2",
        "liberusoftware/sessions-devices-filament": "^1.1",
        "liberusoftware/settings": "^1.5.3",
        "liberusoftware/settings-filament": "^1.0",
        "liberusoftware/tenancy": "^1.0.1",
        "liberusoftware/theme-base": "^2.0",
        "liberusoftware/theme-clear-signal": "^1.0",
        "liberusoftware/theme-dark": "^1.0",
        "liberusoftware/theme-default": "^1.0",
        "liberusoftware/theme-support": "^1.8.4",
        "liberusoftware/theme-support-livewire": "^1.6.2",
        "liberusoftware/two-factor-authentication": "^1.4.7",
        "liberusoftware/users-roles": "^1.0",
        "liberusoftware/webhooks": "^1.0",
        "livewire/livewire": "^4.4.8",
        "php": "^8.5",
        "spatie/laravel-activitylog": "^5.1.3",
        "spatie/laravel-backup": "^10.3.3",
        "spatie/laravel-passkeys": "^1.8.1",
        "spatie/laravel-permission": "^8.3.2",
        "spiral/roadrunner-cli": "^3.0.1",
        "spiral/roadrunner-http": "^4.2.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "filament/upgrade": "^5.11.0",
        "fruitcake/laravel-debugbar": "^4.4.4",
        "larastan/larastan": "^3.13.2",
        "laravel/boost": "^2.10.3",
        "laravel/mcp": "^1.1.2",
        "laravel/pint": "^1.32.1",
        "laravel/sail": "^1.69.0",
        "laravel/telescope": "^5.26.0",
        "liberusoftware/boilerplate-scripts": "^1.1",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "pestphp/pest": "^5.3.3",
        "pestphp/pest-plugin-laravel": "^5.0.1",
        "phpunit/phpunit": "^13.4.3",
        "spatie/laravel-ignition": "^2.12.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "test": "vendor/bin/pest",
        "test:module-host": "@php tests/run-module-host.php"
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "platform": {
            "php": "8.5"
        },
        "platform-check": false,
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "liberusoftware/composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/liberusoftware/module-module-manager-filament.git",
            "only": [
                "liberusoftware/module-manager-filament"
            ]
        },
        {
            "type": "git",
            "url": "https://github.com/liberusoftware/module-localization-mymemory.git",
            "only": [
                "liberusoftware/localization-mymemory"
            ]
        },
        {
            "type": "git",
            "url": "https://github.com/liberusoftware/module-settings.git",
            "only": [
                "liberusoftware/settings"
            ]
        },
        {
            "type": "git",
            "url": "https://github.com/liberusoftware/module-theme-support.git",
            "only": [
                "liberusoftware/theme-support"
            ]
        },
        {
            "type": "git",
            "url": "https://github.com/liberusoftware/module-localization-core.git",
            "only": [
                "liberusoftware/localization-core"
            ]
        },
        {
            "type": "git",
            "url": "https://github.com/liberusoftware/module-localization-core-livewire.git",
            "only": [
                "liberusoftware/localization-core-livewire"
            ]
        },
        {
            "type": "git",
            "url": "https://github.com/liberusoftware/module-theme-support-livewire.git",
            "only": [
                "liberusoftware/theme-support-livewire"
            ]
        },
        {
            "type": "git",
            "url": "https://github.com/liberusoftware/module-organizations-teams.git",
            "only": [
                "liberusoftware/organizations-teams"
            ]
        },
        {
            "type": "git",
            "url": "https://github.com/liberusoftware/module-roles-permissions.git",
            "only": [
                "liberusoftware/roles-permissions"
            ]
        },
        {
            "type": "git",
            "url": "https://github.com/liberusoftware/module-integrations.git",
            "only": [
                "liberusoftware/integrations"
            ]
        },
        {
            "type": "git",
            "url": "https://github.com/liberusoftware/module-module-manager.git",
            "only": [
                "liberusoftware/module-manager"
            ]
        },
        {
            "type": "git",
            "url": "https://github.com/liberusoftware/module-sessions-devices.git",
            "only": [
                "liberusoftware/sessions-devices"
            ]
        },
        {
            "type": "git",
            "url": "https://github.com/liberusoftware/module-two-factor-authentication.git",
            "only": [
                "liberusoftware/two-factor-authentication"
            ]
        },
        {
            "type": "git",
            "url": "https://github.com/liberusoftware/module-identity-socialstream.git",
            "only": [
                "liberusoftware/identity-socialstream"
            ]
        }
    ]
}
