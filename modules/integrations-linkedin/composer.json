{
  "name": "liberusoftware/integrations-linkedin",
  "description": "LinkedIn organic and LinkedIn Ads integration services.",
  "type": "liberu-module",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "illuminate/support": "^13.38.0",
    "liberusoftware/integrations": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "Liberu\\Integrations\\LinkedIn\\": "src/"
    }
  },
  "extra": {
    "liberu": {
      "name": "integrations-linkedin"
    }
  },
  "version": "1.0.0",
  "autoload-dev": {
    "psr-4": {
      "Liberu\\Integrations\\LinkedIn\\Tests\\": "tests/"
    }
  },
  "require-dev": {
    "liberusoftware/package-testbench": "^1.5",
    "pestphp/pest": "^5.3.3"
  },
  "scripts": {
    "test": "pest",
    "test:coverage": "pest --coverage --min=100"
  },
  "config": {
    "allow-plugins": {
      "pestphp/pest-plugin": true
    }
  }
}
